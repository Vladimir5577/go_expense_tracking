# Окружение: local | dev | prod. Влияет на формат логов (text/json).
ENV=local

# Интерфейс, на котором слушает сервис. Пусто — все интерфейсы (удобно, чтобы
# зайти с телефона в локальной сети). За обратным прокси ставьте 127.0.0.1,
# иначе сервис доступен снаружи напрямую, в обход TLS.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Путь к файлу базы. Рядом появятся expenses.db-wal и expenses.db-shm —
# бэкапить нужно вместе с ними либо через VACUUM INTO.
DB_PATH=./data/expenses.db

# Папка со статикой фронтенда. Путь относительный — считается от рабочей
# директории, из которой запущен бинарник.
WEB_DIR=./web

# Секрет подписи JWT. Для локальной разработки можно оставить значение ниже.
# Смена секрета мгновенно инвалидирует все выданные токены — это же
# и есть аварийный способ «разлогинить всех».
JWT_SECRET=dev-secret

# Срок жизни токена. Refresh-токенов нет: истёк — логинимся заново.
JWT_TTL_HOURS=168

# Таймзона решает, какой день считается «сегодня» и как считаются
# границы периодов день/неделя/месяц.
APP_TIMEZONE=Europe/Moscow

# Стоимость bcrypt. 12 — примерно 250 мс на проверку, это само по себе
# ограничивает перебор паролей.
BCRYPT_COST=12

# Защита от перебора: после LOGIN_MAX_ATTEMPTS неудачных попыток вход
# по этому логину блокируется на LOGIN_LOCK_MINUTES минут.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
