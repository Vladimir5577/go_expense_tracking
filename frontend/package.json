{
  "name": "go-expenses-frontend",
  "private": true,
  "description": "Инструментарий фронтенда: сборка стилей Tailwind, линтер и форматирование",
  "scripts": {
    "css": "tailwindcss -i input.css -o ../web/app.css --watch",
    "css:build": "tailwindcss -i input.css -o ../web/app.css --minify",
    "lint": "eslint ../web/js",
    "fmt": "prettier --write ../web/js",
    "fmt:check": "prettier --check ../web/js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3"
  },
  "type": "module"
}
